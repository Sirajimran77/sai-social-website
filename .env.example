# ── SAI Social — environment configuration ──────────────────────────────────
# Copy this file to ".env" and fill in the values, then restart the server.
# The .env file holds secrets — never commit it to git (it is gitignored).

# Port the server listens on (most hosts set this automatically).
PORT=3000

# ── Production only ─────────────────────────────────────────────────────────
# On the VPS, uncomment all three. NODE_ENV=production turns on HSTS,
# upgrade-insecure-requests and proxy-aware rate limiting. HOST=127.0.0.1 keeps
# the app on loopback so it can only be reached through nginx. SITE_ORIGIN
# drives canonical URLs, Open Graph tags, the sitemap and the allowed origin
# for the booking form — get it wrong and the form 403s.
# NODE_ENV=production
# HOST=127.0.0.1
# SITE_ORIGIN=https://www.saisocial.co.uk

# ── Google Ads conversion tracking ──────────────────────────────────────────
# Leave both blank and tracking is off AND the Content-Security-Policy stays
# locked to 'self' — we don't widen the policy for a tag nobody is using.
# Set BOTH or conversions are never reported:
#   GOOGLE_ADS_ID     - "AW-XXXXXXXXXX", from Google Ads → Goals → Conversions
#   ..._LABEL         - the label on the specific conversion action. The tag
#                       Google shows you is 'AW-123456789/AbC-D_efGh12'; the
#                       part after the slash is the label.
# GOOGLE_ADS_ID=AW-XXXXXXXXXX
# GOOGLE_ADS_CONVERSION_LABEL=AbC-D_efGh12

# Where booking enquiries are delivered.
TO_EMAIL=saimanagement77@gmail.com

# ── SMTP (outgoing mail) ─────────────────────────────────────────────────────
# Easiest option: a Gmail account + an "App Password".
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:        https://myaccount.google.com/apppasswords
#   3. Paste the 16-character password (no spaces) into SMTP_PASS below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=saimanagement77@gmail.com
SMTP_PASS=your-16-char-app-password

# Optional: the "From" address shown on the email.
# Defaults to SMTP_USER if left blank.
FROM_EMAIL="SAI Social Website <saimanagement77@gmail.com>"
